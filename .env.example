# Server & Storage
INSIGHT_HOST=127.0.0.1
INSIGHT_PORT=8000
INSIGHT_DATA_DIR=./data

# Optional password for Colab tunnel / shared sessions (leave empty for local single-user)
INSIGHT_PASSWORD=
# Auto-stop backend server shortly after the UI window closes (1 = active, 0 = stay running)
INSIGHT_AUTO_SHUTDOWN=0

# LLM Backend: auto | local_smart | retrieval_only | ollama | unsloth | hf
INSIGHT_LLM_BACKEND=auto
INSIGHT_LLM_MODEL=unsloth/Qwen2.5-7B-Instruct-bnb-4bit

# Precision option for Unsloth / Hugging Face (matches Colab GPU tiers): 4bit | 8bit | full
INSIGHT_PRECISION=4bit
INSIGHT_MAX_SEQ_LENGTH=4096
INSIGHT_MAX_NEW_TOKENS=512

# Local Ollama endpoint (used when INSIGHT_LLM_BACKEND=ollama)
INSIGHT_OLLAMA_URL=http://localhost:11434

# Step-1 Retrieval & Optional Reranker (~22M-278M params)
INSIGHT_EMBED_MODEL=BAAI/bge-small-en-v1.5
INSIGHT_USE_RERANKER=false
INSIGHT_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
INSIGHT_TOP_K_CANDIDATES=12
INSIGHT_TOP_K_FINAL=4

# Chunking
INSIGHT_CHUNK_SIZE=900
INSIGHT_CHUNK_OVERLAP=150
