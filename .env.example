# Server & Storage
INSIGHT_HOST=127.0.0.1
INSIGHT_PORT=8000
INSIGHT_DATA_DIR=./data
# Centralized folder for all downloaded models & caches (HF, FastEmbed, Ollama, Torch)
INSIGHT_RESOURCES_DIR=./resources

# Optional password for shared sessions (leave empty for local single-user)
INSIGHT_PASSWORD=
INSIGHT_TOKEN_TTL_SECONDS=43200
INSIGHT_LOGIN_MAX_ATTEMPTS=5
INSIGHT_LOGIN_WINDOW_SECONDS=60
# Auto-stop backend server shortly after the UI window closes (1 = active, 0 = stay running)
INSIGHT_AUTO_SHUTDOWN=0

# LLM Backend: auto | llamacpp | local_smart | retrieval_only | ollama | unsloth | hf
INSIGHT_LLM_BACKEND=llamacpp
INSIGHT_LLM_MODEL=unsloth/Qwen3-1.7B-GGUF
INSIGHT_GGUF_FILE=Qwen3-1.7B-UD-Q4_K_XL.gguf

# Precision option for Unsloth / Hugging Face: 4bit | 8bit | full
INSIGHT_PRECISION=4bit
INSIGHT_MAX_SEQ_LENGTH=4096
INSIGHT_MAX_NEW_TOKENS=512

# Local Ollama endpoint (used when INSIGHT_LLM_BACKEND=ollama)
INSIGHT_OLLAMA_URL=http://localhost:11434

# Step-1 Retrieval & Dual RAG Mode (only 2 options: hybrid | adaptive)
INSIGHT_RAG_MODE=hybrid
INSIGHT_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Set true to refuse startup when only HashingEmbedder fallback is available
INSIGHT_STRICT_EMBEDDER=false
INSIGHT_USE_RERANKER=false
INSIGHT_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
INSIGHT_TOP_K_CANDIDATES=12
INSIGHT_TOP_K_FINAL=4
INSIGHT_MAX_UPLOAD_MB=50

# Chunking
INSIGHT_CHUNK_SIZE=900
INSIGHT_CHUNK_OVERLAP=150
